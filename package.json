    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "2",
    "@tauri-apps/plugin-updater": "2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "culori": "^4.0.2",
    "gl-waveform": "5.3.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.16",
    "vue-sonner": "^2.0.9"
  },
