{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fonicca",
  "version": "0.1.5",
  "identifier": "app.fonicca",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fonicca",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMEI5RTU1NzNENTVCREEKUldUYVc5VnpWWjRMNnA1WEZHQ0VNZzFrRDhLMzRLZDhUbjU3SWZTN2RJK2lmWGMyaHFBa2ppZjcK",
      "endpoints": [
        "https://github.com/dremchee/fonicca/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
